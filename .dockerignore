# Rebuilt inside the image, so never copy host artifacts/deps in.
node_modules
**/node_modules
out
out_test
dist

# Local data / secrets must not leak into the image.
data
**/.env
*.sqlite

# VCS, CI, editor, docs.
.git
.github
.vscode
.idea
website
*.md
# …except the site's address, which the app's documentation links are built from (website/site.mjs states it once).
!website/site.mjs

# Misc
.DS_Store
npm-debug.log*
